{
  "title": "Wasserportal Berlin Groundwater Demo",
  "image": null,
  "mobileHide": false,
  "mobileOrder": null,
  "configuration": {
    "description": "Auto-importable demo dashboard for the kwb-r/wasserportal ThingsBoard push: shows the five Berlin groundwater stations created by inst/scripts/push_to_thingsboard.R on a map, with current values, master data and time-series.",
    "widgets": {
      "wp-map": {
        "id": "wp-map",
        "isSystemType": true,
        "bundleAlias": "maps",
        "typeAlias": "openstreetmap",
        "type": "latest",
        "title": "Berlin groundwater stations",
        "image": null,
        "sizeX": 12,
        "sizeY": 7,
        "config": {
          "datasources": [
            {
              "type": "entity",
              "entityAliasId": "wasserportal_devices",
              "dataKeys": [
                {
                  "name": "latitude",
                  "type": "attribute",
                  "label": "latitude",
                  "color": "#2196f3",
                  "settings": {},
                  "_hash": 0.1
                },
                {
                  "name": "longitude",
                  "type": "attribute",
                  "label": "longitude",
                  "color": "#4caf50",
                  "settings": {},
                  "_hash": 0.2
                },
                {
                  "name": "Bezirk",
                  "type": "attribute",
                  "label": "Bezirk",
                  "color": "#f44336",
                  "settings": {},
                  "_hash": 0.3
                },
                {
                  "name": "Auspraegung",
                  "type": "attribute",
                  "label": "Auspraegung",
                  "color": "#ff9800",
                  "settings": {},
                  "_hash": 0.4
                }
              ]
            }
          ],
          "title": "Berlin groundwater stations",
          "showTitle": true,
          "settings": {
            "latKeyName": "latitude",
            "lngKeyName": "longitude",
            "showLabel": true,
            "label": "${entityName}",
            "showTooltip": true,
            "tooltipPattern": "<b>${entityName}</b><br/>Bezirk: ${Bezirk}<br/>Ausprägung: ${Auspraegung}<br/>lat/lon: ${latitude}, ${longitude}",
            "defaultZoomLevel": 11,
            "useDefaultCenterPosition": true,
            "defaultCenterPosition": "52.5200,13.4050",
            "fitMapBounds": true,
            "mapProvider": "OpenStreetMap.Mapnik"
          }
        }
      },
      "wp-attributes": {
        "id": "wp-attributes",
        "isSystemType": true,
        "bundleAlias": "cards",
        "typeAlias": "entities_table",
        "type": "latest",
        "title": "Master data per station",
        "sizeX": 12,
        "sizeY": 5,
        "config": {
          "datasources": [
            {
              "type": "entity",
              "entityAliasId": "wasserportal_devices",
              "dataKeys": [
                { "name": "Bezirk", "type": "attribute", "label": "Bezirk", "_hash": 1.1 },
                { "name": "Auspraegung", "type": "attribute", "label": "Ausprägung", "_hash": 1.2 },
                { "name": "Grundwasserleiter", "type": "attribute", "label": "GW-Leiter", "_hash": 1.3 },
                { "name": "Gelaendeoberkante_GOK_m_ue_NHN", "type": "attribute", "label": "GOK [m ü NHN]", "_hash": 1.4 },
                { "name": "Filteroberkante_m_u_GOK", "type": "attribute", "label": "Filter top [m u GOK]", "_hash": 1.5 },
                { "name": "Filterunterkante_m_u_GOK", "type": "attribute", "label": "Filter bottom [m u GOK]", "_hash": 1.6 }
              ]
            }
          ],
          "title": "Master data per station",
          "showTitle": true,
          "settings": {
            "enableSearch": true,
            "displayPagination": true,
            "defaultPageSize": 10,
            "displayEntityName": true,
            "entityNameColumnTitle": "Station"
          }
        }
      },
      "wp-timeseries": {
        "id": "wp-timeseries",
        "isSystemType": true,
        "bundleAlias": "charts",
        "typeAlias": "basic_timeseries",
        "type": "timeseries",
        "title": "Groundwater level history",
        "sizeX": 12,
        "sizeY": 8,
        "config": {
          "datasources": [
            {
              "type": "entity",
              "entityAliasId": "wasserportal_devices",
              "dataKeys": [
                {
                  "name": "GW-Stand",
                  "type": "timeseries",
                  "label": "${entityName} – GW-Stand",
                  "color": "#2196f3",
                  "settings": { "fillLines": false, "showLines": true, "showPoints": false },
                  "_hash": 2.1
                }
              ]
            }
          ],
          "title": "Groundwater level history (last year)",
          "showTitle": true,
          "showLegend": true,
          "settings": {
            "shadowSize": 0,
            "smoothLines": true,
            "stack": false,
            "yaxis": { "min": null, "max": null, "title": "GW-Stand [m ü NHN]" }
          },
          "timewindow": {
            "history": { "timewindowMs": 31536000000 }
          }
        }
      },
      "wp-quality": {
        "id": "wp-quality",
        "isSystemType": true,
        "bundleAlias": "charts",
        "typeAlias": "basic_timeseries",
        "type": "timeseries",
        "title": "Groundwater quality (selected parameters)",
        "sizeX": 12,
        "sizeY": 8,
        "config": {
          "datasources": [
            {
              "type": "entity",
              "entityAliasId": "wasserportal_devices",
              "dataKeys": [
                { "name": "Nitrat", "type": "timeseries", "label": "${entityName} – Nitrat", "color": "#4caf50", "_hash": 3.1 },
                { "name": "Chlorid", "type": "timeseries", "label": "${entityName} – Chlorid", "color": "#ff9800", "_hash": 3.2 },
                { "name": "Sulfat", "type": "timeseries", "label": "${entityName} – Sulfat", "color": "#9c27b0", "_hash": 3.3 }
              ]
            }
          ],
          "title": "Quality parameters (last year)",
          "showTitle": true,
          "showLegend": true,
          "settings": { "smoothLines": false, "stack": false },
          "timewindow": {
            "history": { "timewindowMs": 31536000000 }
          }
        }
      }
    },
    "states": {
      "default": {
        "name": "Wasserportal Berlin",
        "root": true,
        "layouts": {
          "main": {
            "widgets": {
              "wp-map":        { "sizeX": 12, "sizeY": 7, "row": 0,  "col": 0 },
              "wp-attributes": { "sizeX": 12, "sizeY": 5, "row": 7,  "col": 0 },
              "wp-timeseries": { "sizeX": 12, "sizeY": 8, "row": 12, "col": 0 },
              "wp-quality":    { "sizeX": 12, "sizeY": 8, "row": 20, "col": 0 }
            },
            "gridSettings": {
              "backgroundColor": "#eeeeee",
              "color": "rgba(0,0,0,0.870588)",
              "columns": 24,
              "margin": 10,
              "backgroundSizeMode": "100%"
            }
          }
        }
      }
    },
    "entityAliases": {
      "wasserportal_devices": {
        "id": "wasserportal_devices",
        "alias": "Wasserportal devices",
        "filter": {
          "type": "entityName",
          "entityType": "DEVICE",
          "entityNameFilter": "wasserportal-gw-",
          "resolveMultiple": true
        }
      }
    },
    "timewindow": {
      "displayValue": "",
      "selectedTab": 0,
      "realtime": { "interval": 1000, "timewindowMs": 60000 },
      "history": {
        "historyType": 0,
        "interval": 86400000,
        "timewindowMs": 31536000000
      },
      "aggregation": { "type": "AVG", "limit": 5000 }
    },
    "settings": {
      "stateControllerId": "entity",
      "showTitle": true,
      "titleColor": "rgba(0,0,0,0.870588)",
      "showDashboardsSelect": true,
      "showEntitiesSelect": false,
      "showFilters": true,
      "showDashboardTimewindow": true,
      "showDashboardExport": true,
      "toolbarAlwaysOpen": true
    }
  }
}
